{
  "name": "pocket-band",
  "version": "9.0.0",
  "private": true,
  "description": "Pocket Band: a phone music app in one HTML file. The tests play it in headless Chromium.",
  "scripts": {
    "test": "node tests/run-all.mjs",
    "test:quick": "node tests/run-all.mjs --quick",
    "test:pitch": "node tests/run-all.mjs --only=pitch",
    "tracks": "node tools/make-tracks.mjs && node tools/sync-core.mjs",
    "test:tracks": "node tools/verify-tracks.mjs",
    "build:web": "node tools/copy-web.mjs",
    "cap:sync": "node tools/make-android-icons.mjs && node tools/copy-web.mjs && npx cap sync android",
    "android:icons": "node tools/make-android-icons.mjs --preview=docs/android-icon-preview.png"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "playwright": "^1.56.1"
  }
}
